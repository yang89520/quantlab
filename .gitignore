# 依赖
node_modules/

# Python 缓存（回测脚本）
__pycache__/
*.pyc

# 运行时产物：形态扫描缓存按交易日落盘，属可再生数据，不入版本库
data/shape-cache.json
# 自选股 store.json 的原子写临时文件
data/*.tmp

# 日志与本地环境
*.log
npm-debug.log*
.env
.env.*

# macOS
.DS_Store

# 本地助手工作目录（会话记忆、临时产物），不参与版本管理
.workbuddy/

# 本机配置（含上游行情库绝对路径，绝不入库）
config.local.json

# 自有业务库与 JSONL 兜底数据（可由 daily-close 重建，不入库）
data/ql.duckdb
data/ql.duckdb.wal
data/jsonl/
data/sectors/
data/watchpool/
data/sources/
data/strategies/
logs/

# 三期 Python 独立虚拟环境（可重建，不入库）
py/.venv/
