{
  "schema": 1,

  "storage": {
    "engine": "auto",
    "ownDb": "data/ql.duckdb"
  },
  "localDb": {
    "enabled": true,
    "marketDb": ""
  },

  "predict": {
    "weights": { "trend": 40, "breadth": 30, "vol": 30 },
    "verdict": {
      "attack": 65,
      "defend": 35,
      "_note_attack": "初始值。依据：2026-11 人工观察 65 分以上多为顺势环境。需累积 20 个交易日对账后校准。",
      "_note_defend": "初始值。同上，35 分以下判定为防守。"
    },
    "candidateCount": 5,
    "historyDays": 250,
    "scoring": {
      "trendPerCondition": 20,
      "breadthLow": 0.35,
      "breadthSpan": 0.40,
      "volLow": 0.70,
      "volSpan": 0.60
    }
  },

  "integrity": {
    "minSnapshotCount": 4000,
    "minBars": 120
  },

  "judgment": {
    "minSampleDays": 10,
    "minStateSample": 5,
    "candidateMinHitRatio": 0.40,
    "envWeight": 0.5,
    "candWeight": 0.5
  },

  "sector": {
    "minMomentum": 80,
    "minFunds": 70,
    "dropMomentum": 40,
    "minSectors": 10,
    "weights": { "momentum": 0.35, "funds": 0.25, "breadth": 0.20, "continuity": 0.20 },
    "mixRet": { "ret5": 0.40, "ret20": 0.60 },
    "funds": {
      "amountPctile": 0.45, "volScore": 0.25, "netInflowPctile": 0.30,
      "degradedAmount": 0.70, "degradedVol": 0.30
    },
    "volScore": { "base": 0.5, "span": 1.0 },
    "breadth": { "upRatio": 0.8, "zt": 0.2, "ztFull": 5, "neutralUpRatio": 50 },
    "continuityDays": 20,
    "amountLookback": 250,
    "aggregate": { "base": 1000, "minMembers": 5 },
    "directionRank": 0.70,
    "mainlineTop": 3
  },

  "watchpool": {
    "maxStay": { "watching": 10, "ambush": 15, "confirmed": 5 },
    "maxSize": 30,
    "minScore": 70,
    "bandLow": 0.98,
    "bandHigh": 1.03,
    "shrink": 0.8,
    "breakoutVol": 1.5,
    "holdTol": 0.97,
    "confirmWindow": 3,
    "removeVol": 1.2,
    "snapshotLimit": 60,
    "removedRetentionDays": 90
  },

  "gates": {
    "maxDecay": 0.5,
    "minUniverse": 30,
    "minPositiveRatio": 0.5,
    "minPhaseRet": -0.05,
    "degradeGap": 0.15,
    "split": 0.7,
    "oosMinBars": 100,
    "universePool": 200,
    "universeSample": 50,
    "sampleSeed": 20261113,
    "phaseLookback": 250,
    "phaseBull": 0.15,
    "phaseBear": -0.15,
    "phaseMinDays": 60,
    "dualUniverse": 100,
    "dualAgreeRate": 0.99,
    "dynamicK": 20,
    "checkEveryDays": 20,
    "trackDays": [1, 5, 10],
    "pythonTimeoutMs": 120000,
    "maxConcurrent": 1,
    "_note_maxConcurrent": "初始值。五道闸异步任务的并发上限：跑 50 只 × 4 道会吃满 CPU 与 Python 子进程，串行反而更快；超出上限的任务排队等待。",
    "_note_checkEveryDays": "初始值。每 N 个交易日检查一次实盘命中率是否显著低于回测，低于 degradeGap 则自动降级 suspect。"
  },

  "cache": {
    "enabled": true,
    "dir": "data/cache",
    "keepDays": 7,
    "_note_keepDays": "初始值。二级缓存目录按自然日分，跨日必失效（D3）；只保留最近 N 天供排查与归档。"
  },

  "signals": {
    "pool": 200,
    "bars": 250,
    "minBars": 60,
    "_note_pool": "初始值。每日信号扫描的预筛池大小：取当日成交额前 N 只（05 §7.1 的形态层预筛，成本约为全市场的 1/25）。",
    "_note_bars": "初始值。逐只回测读取的 K 线根数，需覆盖策略最长周期。"
  },

  "ui": {
    "timing": {
      "lowOpenPct": 0.02,
      "_note_lowOpenPct": "初始值。③ 时机格的失效条件口径：信号标的次日多数低开超过该幅度即视为时机判错。"
    },
    "candidate": {
      "startWindowDays": 3,
      "maxPerGroup": 2,
      "_note_startWindowDays": "初始值。④ 候选格失效条件：入池后该交易日数内未启动则降级。"
    },
    "risk": {
      "breakMa": 20,
      "weakenMa": 10,
      "reduceChgPct": -5,
      "_note_breakMa": "初始值。⑤ 风险格：收盘跌破该均线记「破位」。",
      "_note_weakenMa": "初始值。收盘跌破该均线记「转弱」。",
      "_note_reduceChgPct": "初始值。当日跌幅低于该百分数记「减仓」。"
    }
  },

  "sources": {
    "pacingMs": { "none": 0, "low": 0, "med": 300, "high": 500 },
    "downAfterFails": 3,
    "downWindow": 5,
    "cooldownMin": 20,
    "probeIntervalMin": 5,
    "sectorMemberPages": 5,
    "sectorMemberPageSize": 100
  }
}
